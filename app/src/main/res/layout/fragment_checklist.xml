<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_light_background"
    tools:context=".ui.checklist.ChecklistFragment">

        <!-- Search Bar -->
        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurface"
            app:elevation="@dimen/elevation_2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_16">

                <!-- Search Field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Search checklists..."
                    app:startIconDrawable="@drawable/ic_search_24dp"
                    app:boxBackgroundMode="filled"
                    app:boxBackgroundColor="?attr/colorSurfaceVariant"
                    app:boxCornerRadiusTopStart="@dimen/corner_radius_medium"
                    app:boxCornerRadiusTopEnd="@dimen/corner_radius_medium"
                    app:boxCornerRadiusBottomStart="@dimen/corner_radius_medium"
                    app:boxCornerRadiusBottomEnd="@dimen/corner_radius_medium"
                    app:boxStrokeWidth="0dp"
                    style="@style/Widget.Material3.TextInputLayout.FilledBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_search"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColorHint="?attr/colorOnSurfaceVariant" />

                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- Checklists Grid (Google Keep style) -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/spacing_16"
            android:paddingStart="@dimen/spacing_16"
            android:paddingEnd="@dimen/spacing_16"
            android:paddingBottom="@dimen/spacing_80"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Grid container for checklists -->
        <LinearLayout
            android:id="@+id/checklists_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

        <!-- Empty State (Google Keep style) -->
        <LinearLayout
            android:id="@+id/layout_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="@dimen/spacing_32"
            android:visibility="gone"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/ic_checklist_24dp"
            android:tint="@color/sage_green"
            android:alpha="0.3"
            android:layout_marginBottom="@dimen/spacing_24" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No checklists yet"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textColor="@color/md_theme_light_onBackground"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/spacing_8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create your first checklist by tapping the + button"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="@color/md_theme_light_onSurfaceVariant"
            android:gravity="center"
            android:layout_marginBottom="@dimen/spacing_32" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_create_first_checklist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Checklist"
            app:backgroundTint="@color/sage_green"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_add_24dp"
            app:iconGravity="textStart"
            style="@style/Widget.Material3.Button" />

    </LinearLayout>

    <!-- Floating Action Button (Google Keep style) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_checklist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/spacing_16"
        android:contentDescription="Add Checklist"
        android:src="@drawable/ic_add_24dp"
        app:backgroundTint="@color/sage_green"
        app:tint="@color/md_theme_light_onPrimary"
        app:fabSize="normal"
        app:borderWidth="0dp"
        android:layout_gravity="bottom|end" />

    <!-- Legacy TextView for Java compatibility -->
    <TextView
        android:id="@+id/text_checklist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/menu_checklist"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
