<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.VEB_APP" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/sage_green</item>
        <item name="colorPrimaryVariant">@color/sage_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/sage_green_light</item>
        <item name="colorSecondaryVariant">@color/sage_green_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.VEB_APP.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.VEB_APP.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.VEB_APP.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <!-- Custom NavigationView Style -->
    <style name="NavigationViewStyle" parent="Widget.MaterialComponents.NavigationView">
        <item name="itemIconTint">@color/sage_green</item>
        <item name="itemTextColor">@color/black</item>
        <item name="itemBackground">@drawable/nav_item_background</item>
        <item name="itemTextAppearance">@style/NavigationItemTextAppearance</item>
    </style>

    <!-- Navigation Item Text Appearance -->
    <style name="NavigationItemTextAppearance" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/black</item>
    </style>
</resources>