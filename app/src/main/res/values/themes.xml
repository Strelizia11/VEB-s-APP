<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.VEB_APP" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Material 3 Color System -->
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_light_onPrimaryContainer</item>
        
        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_light_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_light_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_light_onSecondaryContainer</item>
        
        <item name="colorTertiary">@color/md_theme_light_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_light_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_light_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_light_onTertiaryContainer</item>
        
        <item name="colorError">@color/md_theme_light_error</item>
        <item name="colorOnError">@color/md_theme_light_onError</item>
        <item name="colorErrorContainer">@color/md_theme_light_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_light_onErrorContainer</item>
        
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>
        
        <item name="android:colorBackground">@color/md_theme_light_background</item>
        
        <item name="colorOutline">@color/md_theme_light_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_light_outlineVariant</item>
        
        <item name="colorSurfaceInverse">@color/md_theme_light_inverseSurface</item>
        <item name="colorOnSurfaceInverse">@color/md_theme_light_inverseOnSurface</item>
        <item name="colorPrimaryInverse">@color/md_theme_light_inversePrimary</item>
        
        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/md_theme_light_primary</item>
        <item name="android:windowLightStatusBar">false</item>
        
        <!-- Navigation bar color -->
        <item name="android:navigationBarColor">@color/md_theme_light_surface</item>
        <item name="android:windowLightNavigationBar">true</item>
        
        <!-- Material 3 Shape System -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.VEB_APP.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.VEB_APP.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.VEB_APP.LargeComponent</item>
        
        <!-- Typography -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.VEB_APP.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.VEB_APP.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.VEB_APP.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.VEB_APP.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.VEB_APP.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.VEB_APP.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.VEB_APP.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.VEB_APP.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.VEB_APP.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.VEB_APP.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.VEB_APP.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.VEB_APP.LabelSmall</item>
    </style>

    <style name="Theme.VEB_APP.NoActionBar" parent="Theme.VEB_APP">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Material 3 Shape Styles -->
    <style name="ShapeAppearance.VEB_APP.SmallComponent" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    
    <style name="ShapeAppearance.VEB_APP.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    
    <style name="ShapeAppearance.VEB_APP.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <!-- Material 3 Typography Styles -->
    <style name="TextAppearance.VEB_APP.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/md_theme_light_onBackground</item>
    </style>
    
    <style name="TextAppearance.VEB_APP.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/md_theme_light_onBackground</item>
    </style>
    
    <style name="TextAppearance.VEB_APP.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/md_theme_light_onBackground</item>
    </style>
    
    <style name="TextAppearance.VEB_APP.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/md_theme_light_onBackground</item>
    </style>
    
    <style name="TextAppearance.VEB_APP.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/md_theme_light_onBackground</item>
    </style>
    
    <style name="TextAppearance.VEB_APP.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">@color/md_theme_light_onBackground</item>
    </style>
    
    <style name="TextAppearance.VEB_APP.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/md_theme_light_onBackground</item>
    </style>
    
    <style name="TextAppearance.VEB_APP.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/md_theme_light_onBackground</item>
    </style>
    
    <style name="TextAppearance.VEB_APP.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/md_theme_light_onSurfaceVariant</item>
    </style>
    
    <style name="TextAppearance.VEB_APP.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/md_theme_light_onBackground</item>
    </style>
    
    <style name="TextAppearance.VEB_APP.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/md_theme_light_onBackground</item>
    </style>
    
    <style name="TextAppearance.VEB_APP.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/md_theme_light_onSurfaceVariant</item>
    </style>

    <!-- Custom Component Styles -->
    <style name="Widget.VEB_APP.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardElevation">2dp</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="android:layout_margin">8dp</item>
    </style>
    
    <style name="Widget.VEB_APP.FilledButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="cornerRadius">12dp</item>
    </style>
    
    <style name="Widget.VEB_APP.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- NavigationView Style -->
    <style name="NavigationViewStyle" parent="Widget.Material3.NavigationView">
        <item name="itemIconTint">?attr/colorOnSurface</item>
        <item name="itemTextColor">?attr/colorOnSurface</item>
        <item name="itemBackground">@drawable/nav_item_background</item>
        <item name="itemTextAppearance">@style/NavigationItemTextAppearance</item>
        <item name="itemIconSize">24dp</item>
        <item name="itemMaxLines">1</item>
        <item name="android:background">?attr/colorSurface</item>
    </style>

    <!-- Navigation Item Text Appearance -->
    <style name="NavigationItemTextAppearance" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/md_theme_light_onSurface</item>
    </style>

    <!-- AppBar Overlay Theme -->
    <style name="Theme.VEB_APP.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:textColorPrimary">@color/md_theme_light_onPrimary</item>
        <item name="android:textColorSecondary">@color/md_theme_light_onPrimary</item>
    </style>

    <!-- Popup Overlay Theme -->
    <style name="Theme.VEB_APP.PopupOverlay" parent="ThemeOverlay.AppCompat.Light">
        <item name="android:textColorPrimary">@color/md_theme_light_onSurface</item>
        <item name="android:textColorSecondary">@color/md_theme_light_onSurfaceVariant</item>
        <item name="android:background">@color/md_theme_light_surface</item>
    </style>
</resources>